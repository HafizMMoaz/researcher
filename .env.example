# =========================
# OPENAI
# =========================

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# =========================
# METABASE
# =========================

NEXT_PUBLIC_METABASE_URL=http://localhost:3001

NEXT_PUBLIC_METABASE_DASHBOARD_URL=http://localhost:3001/dashboard/1?date_grouping=&date_range=&product_category=Doohickey&product_category=Gizmo&product_category=Gadget&product_category=Widget&tab=1-overview&vendor=


# =========================
# UNSTRUCTURED.IO
# =========================

UNSTRUCTURED_API_KEY=your_unstructured_api_key

UNSTRUCTURED_URL=https://api.unstructured.io


# =========================
# CHROMADB
# =========================

CHROMA_URL=http://localhost:8000

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false


# =========================
# APP
# =========================

NEXT_PUBLIC_APP_URL=http://localhost:5500

NODE_ENV=development


# =========================
# FILE STORAGE
# =========================

UPLOAD_DIR=./uploads


# =========================
# OPTIONAL DATABASE
# =========================

DATABASE_URL=postgresql://postgres:password@localhost:5432/researcher


# =========================
# WHATSAPP (LATER)
# =========================

META_VERIFY_TOKEN=test_verify_token

WHATSAPP_TOKEN=your_whatsapp_token

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id